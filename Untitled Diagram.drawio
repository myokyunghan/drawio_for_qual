        <mxCell id="UHKvrZoLikHgII5Ms00M-6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;verticalAlign=top;" value="&lt;b&gt;자연실험&lt;/b&gt;&lt;br&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;실험에 근사시키기&lt;/div&gt;&lt;div&gt;단일집단 사전사후 조사 설계&lt;/div&gt;&lt;div&gt;but 한계점&lt;/div&gt;" vertex="1">
