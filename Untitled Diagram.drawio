        <mxCell id="UHKvrZoLikHgII5Ms00M-5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;verticalAlign=top;" value="&lt;b&gt;디지털흔적&lt;/b&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;레디메이드데이터&lt;/div&gt;&lt;div&gt;비대표성&lt;/div&gt;&lt;div&gt;변동성&lt;/div&gt;" vertex="1">
