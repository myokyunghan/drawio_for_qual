        <mxCell id="scfXBnfajFlrqylB7pyz-4" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;autosizeText=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;fontSize=17;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;" value="어떤 사람에게는 임의로 조치를 하고 다른 사람에게는 하지 않는 사건을 찾아서 분석하는것이랍니다.." vertex="1">
