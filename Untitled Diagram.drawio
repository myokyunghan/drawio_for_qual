        <mxCell id="scfXBnfajFlrqylB7pyz-48" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="2023.03" vertex="1">
